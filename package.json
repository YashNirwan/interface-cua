{
  "name": "interface-cua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computer-use automation: LLM discovers a flow in a legacy UI, it is recorded as a typed capability artifact, and replayed deterministically with no model in the loop.",
  "engines": { "node": ">=20" },
  "scripts": {
    "app": "tsx apps/meridian/server.ts",
    "cua": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
