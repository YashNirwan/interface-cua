# Discovery needs ONE model provider. Replay needs neither.
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# CUA_LLM=groq            # or 'anthropic'; omit to auto-select whichever key is set
# CUA_MODEL=              # override the provider's default model

# Credentials for the demo target app. Never stored in a capability artifact.
MERIDIAN_USER=demo.operator
MERIDIAN_PASSWORD=Passw0rd!demo

# CUA_HEADLESS=0                      # force a visible browser (real human takeover)
# CUA_OPERATOR=you@example.com        # operator name shown in the console
# CUA_AUTO_RESOLVE_ESCALATIONS=       # TEST AFFORDANCE ONLY: approve|resume|skip|abort
